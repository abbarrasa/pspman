<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PSPMan.Desktop.ViewModels"
        xmlns:views="using:PSPMan.Desktop.Views"
        xmlns:games="using:PSPMan.Core.Games"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="650"
        x:Class="PSPMan.Desktop.Views.MainWindow" x:Name="WindowRoot"
        x:DataType="vm:MainViewModel" x:CompileBindings="True"
        Width="1200" Height="650" MinWidth="900" MinHeight="450"
        Icon="/Assets/avalonia-logo.ico"
        Title="PSPMan">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <Window.Resources>
        <views:DeviceWorkspaceWidthConverter x:Key="CatalogColumnWidth" WithDevices="170" WithoutDevices="240" />
        <views:DeviceWorkspaceWidthConverter x:Key="EditorColumnWidth" WithDevices="240" WithoutDevices="360" />
        <views:DeviceWorkspaceWidthConverter x:Key="DeviceColumnWidth" WithDevices="270" WithoutDevices="0" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="20">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Game catalog" FontSize="24" FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="GetCsvTemplateButton" Content="Get CSV template"
                        Command="{Binding OpenCsvTemplateCommand}" IsEnabled="{Binding CanOpenCsvTemplate}" />
                <Button x:Name="ImportCatalogButton" Content="Import catalog"
                        Command="{Binding OpenImportCommand}" IsEnabled="{Binding CanOpenImport}" />
                <Button x:Name="ExportCatalogButton" Content="Export catalog"
                        Command="{Binding OpenExportCommand}"
                        IsEnabled="{Binding CanOpenExport}" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="ImportFormPanel" Grid.Row="1" Margin="0,12,0,0"
                      MaxHeight="240" IsVisible="{Binding IsImportFormOpen}">
            <StackPanel Spacing="8">
                <TextBlock Text="Import catalog from CSV" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ChooseImportFileButton" Content="Choose CSV"
                            Command="{Binding ChooseImportFileCommand}" IsEnabled="{Binding CanChooseImportFile}" />
                    <Button x:Name="PreviewImportButton" Content="Preview changes"
                            Command="{Binding PreviewImportCommand}" IsEnabled="{Binding CanPreviewImport}" />
                    <Button x:Name="CancelImportButton" Content="Cancel"
                            Command="{Binding CancelImportCommand}" IsEnabled="{Binding CanCancelImport}" />
                </StackPanel>
                <TextBlock x:Name="ImportSourcePathText" Text="{Binding ImportSourcePath}" TextWrapping="Wrap" />
                <ProgressBar x:Name="ImportProgressBar" IsIndeterminate="True" Height="4"
                             IsVisible="{Binding IsImportBusy}" />
                <TextBlock x:Name="ImportStatusText" Text="{Binding ImportStatusText}" TextWrapping="Wrap" />
                <ItemsControl x:Name="ImportRowErrorsList" ItemsSource="{Binding ImportRowErrors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="games:GameCatalogImportRowError">
                            <StackPanel Spacing="2" Margin="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Line" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StartLine}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="ImportConfirmationPanel" Spacing="6" IsVisible="{Binding HasImportPreview}">
                    <TextBlock Text="Import these proposed changes?" FontWeight="SemiBold" />
                    <Button x:Name="ConfirmImportButton" Content="Import"
                            Command="{Binding ConfirmImportCommand}" IsEnabled="{Binding CanConfirmImport}" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock x:Name="ImportErrorText" Text="{Binding ImportError}"
                           IsVisible="{Binding HasImportError}" TextWrapping="Wrap" />
                <ItemsControl x:Name="ImportSaveErrorsList" ItemsSource="{Binding ImportSaveErrors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="games:GameCatalogImportRowError">
                            <StackPanel Spacing="2" Margin="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Line" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StartLine}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="ExportFormPanel" Grid.Row="2" Margin="0,12,0,0" Spacing="8"
                    IsVisible="{Binding IsExportFormOpen}">
            <TextBlock x:Name="ExportFormTitleText" Text="{Binding ExportFormTitle}" FontSize="18" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ChooseExportFolderButton" Content="Choose folder"
                        Command="{Binding ChooseExportFolderCommand}" />
                <TextBlock x:Name="ExportFolderPathText" Text="{Binding ExportFolderPath}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="CSV file name" VerticalAlignment="Center" />
                <TextBox x:Name="ExportFileNameInput" Width="280"
                         Text="{Binding ExportFileName, Mode=TwoWay}" />
                <Button x:Name="ExportFileButton" Content="{Binding ExportActionText}"
                        Command="{Binding ExportCatalogCommand}"
                        IsEnabled="{Binding CanExportCatalog}" />
                <Button x:Name="CancelExportButton" Content="Cancel"
                        Command="{Binding CancelExportCommand}" />
            </StackPanel>
            <StackPanel x:Name="ExportReplacementPanel" Spacing="6"
                        IsVisible="{Binding IsReplacementPending}">
                <TextBlock x:Name="ExportReplacementPromptText" Text="{Binding ExportReplacementPrompt}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="PendingExportPathText" Text="{Binding PendingReplacementPath}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ReplaceExportButton" Content="Replace"
                            Command="{Binding ConfirmExportReplacementCommand}"
                            IsEnabled="{Binding CanConfirmExportReplacement}" />
                    <Button x:Name="DeclineExportButton" Content="Keep existing file"
                            Command="{Binding CancelExportReplacementCommand}"
                            IsEnabled="{Binding IsReplacementPending}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="ExportSuccessPanel" Grid.Row="3" Margin="0,12,0,0" Spacing="4"
                    IsVisible="{Binding HasExportSuccess}">
            <TextBlock x:Name="ExportSuccessHeadingText" Text="{Binding ExportSuccessHeading}" FontWeight="SemiBold" />
            <TextBlock x:Name="ExportSuccessPathText" Text="{Binding ExportedPath}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="ExportErrorText" Grid.Row="3" Margin="0,12,0,0"
                   Text="{Binding ExportError}" IsVisible="{Binding HasExportError}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Margin="0,12,0,0" Spacing="4"
                    IsVisible="{Binding HasAnyError}">
            <TextBlock x:Name="CatalogErrorText" Text="{Binding CatalogError}"
                       IsVisible="{Binding HasStartupError}"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="OperationErrorText" Text="{Binding OperationError}"
                       IsVisible="{Binding HasDistinctOperationError}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <Grid x:Name="CatalogWorkspace" Grid.Row="5" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding #WindowRoot.((vm:MainViewModel)DataContext).HasDevices, Converter={StaticResource CatalogColumnWidth}}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding #WindowRoot.((vm:MainViewModel)DataContext).HasDevices, Converter={StaticResource EditorColumnWidth}}" />
                <ColumnDefinition Width="{Binding #WindowRoot.((vm:MainViewModel)DataContext).HasDevices, Converter={StaticResource DeviceColumnWidth}}" />
            </Grid.ColumnDefinitions>
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                <TextBlock Text="Games" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="EmptyStateText" Text="No games in the catalog."
                               IsVisible="{Binding IsEmpty}" />
                </StackPanel>
                <ListBox x:Name="GamesList" Grid.Row="2" ItemsSource="{Binding Games}"
                         AutomationProperties.Name="Game catalog"
                         SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                         IsVisible="{Binding HasGames}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="games:GameRecord">
                            <StackPanel Margin="4" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="DeleteConfirmationPanel" Grid.Row="3" Spacing="8" IsVisible="{Binding IsDeletePending}">
                    <TextBlock Text="Delete this catalog record?"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PendingDeleteTitleText" Text="{Binding PendingDeleteTitle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="The game file will not be deleted."
                               TextWrapping="Wrap" />
                    <Button x:Name="ConfirmDeleteButton" Content="Confirm delete"
                            Command="{Binding ConfirmDeleteCommand}"
                            HorizontalAlignment="Left" />
                    <Button x:Name="CancelDeleteButton" Content="Cancel"
                            Command="{Binding CancelDeleteCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Column="1" Margin="20,0,0,0"
                       Text="Select a game to view its details."
                       IsVisible="{Binding NeedsSelection}" />
            <ScrollViewer x:Name="GameDetailsScrollViewer" Grid.Column="1" Margin="12,0,0,0"
                          HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Selected game details"
                          IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Game details" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Title" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedTitleText" Text="{Binding SelectedTitleText}" TextWrapping="Wrap" />
                    <Border x:Name="GameDestinationPanel" IsVisible="{Binding HasDevices}"
                            BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1" Padding="8">
                        <StackPanel DataContext="{Binding Devices}" x:DataType="vm:DevicesViewModel" Spacing="5">
                            <TextBlock Text="PSP destination" FontWeight="SemiBold" />
                            <TextBlock x:Name="PspDestinationStatusText" Text="{Binding GameDestination.StatusText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedPspNameText" Text="{Binding GameDestination.SelectedDeviceName}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding GameDestination.Volumes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceVolumeViewModel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Root}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="PspDestinationOptions" ItemsSource="{Binding GameDestination.Options}"
                                          IsVisible="{Binding GameDestination.HasDestinationChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PspDestinationOptionViewModel">
                                        <StackPanel Spacing="3" Margin="0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Choice.Device.ProviderId}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Choice.Device.DeviceId}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Volumes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DeviceVolumeViewModel">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Root}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Selected PSP" IsVisible="{Binding IsSelected}" />
                                            <Button x:Name="ChoosePspButton" Content="Use PSP"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Use PSP {0}'}"
                                                    Command="{Binding SelectCommand}" IsEnabled="{Binding CanSelect}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding DestinationSelectionError}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Medium" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedMediumText" Text="{Binding SelectedMediumText}" />
                    <TextBlock Text="DVD number" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedDvdNumberText" Text="{Binding SelectedDvdNumberText}" />
                    <TextBlock Text="Location" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedLocationText" Text="{Binding SelectedLocationText}" TextWrapping="Wrap" />
                    <TextBlock Text="Format" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedFormatText" Text="{Binding SelectedFormatText}" />
                    <TextBlock Text="Decompressed size (bytes)" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedSizeText" Text="{Binding SelectedSizeText}" />
                    <TextBlock Text="Approximate size (binary units)" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedReadableSizeText" Text="{Binding SelectedReadableSizeText}" />
                    <TextBlock Text="Notes" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedNotesText" Text="{Binding SelectedNotesText}" TextWrapping="Wrap" />
                    <Button x:Name="EditSelectedButton" Content="Edit selected"
                            Command="{Binding StartEditCommand}"
                            IsVisible="{Binding IsAdding}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Button x:Name="DeleteSelectedButton" Content="Delete selected"
                            Command="{Binding DeleteSelectedCommand}"
                            IsVisible="{Binding IsAdding}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="GameEditorScrollViewer" Grid.Column="2" Margin="12,0,0,0"
                          HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Game editor"
                          IsVisible="{Binding IsEditorAvailable}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Game editor" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Editing record:" IsVisible="{Binding IsEditing}" />
                    <TextBlock Text="{Binding EditingGameTitle}"
                               IsVisible="{Binding IsEditing}" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Fields marked * are required." TextWrapping="Wrap" />

                    <TextBlock Text="Title *" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="TitleInput" Text="{Binding Editor.Title, Mode=TwoWay}" />
                    <TextBlock x:Name="TitleErrorText" Text="{Binding Editor.TitleError}"
                               IsVisible="{Binding Editor.HasTitleError}" TextWrapping="Wrap" />

                    <TextBlock Text="Medium *" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ComboBox x:Name="MediumInput" ItemsSource="{Binding Editor.MediumChoices}"
                              SelectedItem="{Binding Editor.SelectedMedium, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameMediumChoice">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding Editor.MediumError}"
                               IsVisible="{Binding Editor.HasMediumError}" TextWrapping="Wrap" />

                    <TextBlock Text="DVD number *" FontWeight="SemiBold" Margin="0,8,0,0"
                               IsVisible="{Binding Editor.ShowDvdNumber}" />
                    <TextBox x:Name="DvdNumberInput" Text="{Binding Editor.DvdNumberText, Mode=TwoWay}"
                             IsVisible="{Binding Editor.ShowDvdNumber}" />
                    <TextBlock x:Name="DvdNumberErrorText" Text="{Binding Editor.DvdNumberError}"
                               IsVisible="{Binding Editor.HasDvdNumberError}" TextWrapping="Wrap" />

                    <TextBlock Text="Location *" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="LocationInput" Text="{Binding Editor.Location, Mode=TwoWay}"
                             PlaceholderText="/DevHook/GAMES/Game.rar" />
                    <TextBlock x:Name="LocationErrorText" Text="{Binding Editor.LocationError}"
                               IsVisible="{Binding Editor.HasLocationError}" TextWrapping="Wrap" />

                    <TextBlock Text="Format *" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ComboBox x:Name="FormatInput" ItemsSource="{Binding Editor.FormatChoices}"
                              SelectedItem="{Binding Editor.SelectedFormat, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameFormatChoice">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding Editor.FormatError}"
                               IsVisible="{Binding Editor.HasFormatError}" TextWrapping="Wrap" />

                    <TextBlock Text="Decompressed size entered by you (bytes) *"
                               FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBox x:Name="SizeInput" Text="{Binding Editor.SizeBytesText, Mode=TwoWay}" />
                    <TextBlock x:Name="SizeErrorText" Text="{Binding Editor.SizeBytesError}"
                               IsVisible="{Binding Editor.HasSizeBytesError}" TextWrapping="Wrap" />
                    <TextBlock Text="Approximate size (binary units)" />
                    <TextBlock Text="{Binding Editor.HumanReadableSizeText}" />

                    <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="NotesInput" Text="{Binding Editor.Notes, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                    <TextBlock x:Name="NotesErrorText" Text="{Binding Editor.NotesError}"
                               IsVisible="{Binding Editor.HasNotesError}" TextWrapping="Wrap" />

                    <Button Content="Check fields"
                            Command="{Binding Editor.CheckFieldsCommand}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Button x:Name="AddGameButton" Content="Add game"
                            IsEnabled="{Binding IsAdding}"
                            Command="{Binding AddGameCommand}"
                            IsVisible="{Binding IsAdding}"
                            HorizontalAlignment="Left" />
                    <Button x:Name="SaveChangesButton" Content="Save changes"
                            Command="{Binding SaveChangesCommand}"
                            IsVisible="{Binding IsEditing}"
                            HorizontalAlignment="Left" />
                    <Button Content="Cancel edit"
                            Command="{Binding CancelEditCommand}"
                            IsVisible="{Binding IsEditing}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="3" IsVisible="{Binding HasDevices}" Margin="12,0,0,0"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1" CornerRadius="4">
                <views:DevicesView x:Name="DevicePanel" DataContext="{Binding Devices}" />
            </Border>
        </Grid>
    </Grid>
</Window>
